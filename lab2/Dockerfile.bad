# Bad-practice! исполльзование latest, а не конкретной версии нестабильно тк при последующих сборках
# версия может поменяться и это приведет к поломке зависимостей (имена пакетов, пути к файлам, версии библиотек и тд)
FROM ubuntu:latest

# Bad-practice! (каждая команда создает новый слой со своими временными файлами 
# => сборка становится дольше, к тому же, в нашем примере, при установке пакетов в разных RUN, кеш из apt-get update устареет к моменту загрузки следующих RUN)
# Слой - это снимок текущего состояния всей файловой системы внутри контейнера, который делается после выполнения каждой команды. Слои нужны для более быстрой работы и много чего еще
RUN apt-get update
RUN apt-get install -y python3
RUN apt-get install -y curl
RUN apt-get install -y vim

WORKDIR /app

# Bad-practice! храним важные данные в небезопасных ENV переменных. Эти данные останутся в истории образа и станут уязвимостью.
ENV SECRET_KEY="12345-super-secret"
# Bad-practice! запускаем всё под root-пользователем, Это уязвимость безопасности, если кто-то получит доступ к контейнеру (контейнер - это наш изолированный процесс) извне, 
#то он получит root права и сможет влиять на хост-систему

COPY app.py /app/app.py
CMD ["python3", "app.py"]

# Bad-practice! выполняем всё под управлением root-пользователя, что станет уязвимостью для хост-машины, если доступ к контейнеру может быть получен извне